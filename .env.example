# Copy to .env and fill in the affiliate read-only keys.
# Do not enable trade or withdraw permission on these keys.

GATE_API_KEY=
GATE_API_SECRET=
# Optional. Your own Gate UID. Direct referrals must match this inviter.
GATE_UID=
GATE_API_HOST=https://api.gateio.ws

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_HOST=https://www.okx.com

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_HOST=https://api.binance.com
# Optional fallback when the Binance key is not set. One UID per line.
BINANCE_UID_FILE=/data/binance_uids.txt

# Protects GET /api/applications
ADMIN_TOKEN=

DATA_DIR=/data
# Set to 1 only when the service sits behind a reverse proxy.
TRUST_PROXY=0

# Local demo only. Never enable this on the server.
MOCK_VERIFY=0
MOCK_UIDS=
